{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "description": "TypeScript durable execution framework for resilient application workflows",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/order-system"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "npm run dev --workspace @continuum/order-system-demo"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
